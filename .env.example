# ── Gemini / VLM Configuration ──────────────────────────────
# Required: Google AI Studio / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended: gemini-3.8-flash | Alternatives: gemini-2.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.8-flash

# ── GitHub PR Integration ───────────────────────────────────
# Personal Access Token with 'repo' scope for autonomous PR creation
GITHUB_TOKEN=your_github_token_here
# Target repository in owner/repo format
GITHUB_REPO=your-username/your-repo-name
# Optional secret for validating X-Hub-Signature-256 webhook payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── Application & Database Settings ─────────────────────────
STAGING_URL=http://localhost:8000/mock-app/index.html
DATABASE_URL=sqlite+aiosqlite:///./omnisight.db
MAX_FIX_RETRIES=3
